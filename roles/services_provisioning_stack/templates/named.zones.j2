# BIND DNS Zone Configuration

# Primary Zones Configuration
zone "example.com" IN {
  type master;
  file "named.example.com";
  allow-transfer { none; };
  allow-query { any; };
};

zone "prod.example.com" IN {
  type master;
  file "named.prod.example.com";
  allow-transfer { none; };
  allow-query { any; };
};

zone "lab.example.com" IN {
  type master;
  file "named.lab.example.com";
  allow-transfer { none; };
  allow-query { any; };
};
