---
# Non-Sensitive Variables for GCP-AAP-Satellite Integration
# Generated by aap_gcp role

# Satellite configuration
satellite_url: {{ aap_satellite_url }}
satellite_organization: {{ aap_satellite_organization }}
satellite_location: {{ aap_satellite_location }}
satellite_hostgroup: {{ aap_satellite_hostgroup }}
satellite_activation_key: {{ aap_satellite_activation_key }}
satellite_verify_ssl: {{ aap_satellite_verify_ssl | lower }}

# GCP configuration
gcp_project_id: {{ aap_gcp_project_id }}
gcp_region: {{ aap_gcp_region }}

# RHEL version mapping
rhel_version_packages:
{% for version, package in aap_rhel_version_packages.items() %}
  '{{ version }}': {{ package }}
{% endfor %}

# Network configuration
ssh_connection_timeout: {{ aap_ssh_connection_timeout }}
max_fail_percentage: {{ aap_workflow_max_fail_percentage }}
