---
# Encrypted Variables for GCP-AAP-Satellite Integration
# This file will be encrypted with ansible-vault
# Generated by aap_gcp role

# Satellite credentials
vault_satellite_username: {{ aap_satellite_username }}
vault_satellite_password: {{ aap_satellite_password | default(satellite_admin_password | default(global_admin_password | default(''))) }}

# GCP Service Account
vault_gcp_service_account_file: {{ aap_gcp_service_account_file }}

# AAP credentials (for export/import)
vault_aap_admin_password: {{ aap_controller_password | default(aap_admin_password | default(global_admin_password | default(''))) }}

# Notification credentials
{% if aap_notification_slack_enabled %}
vault_slack_webhook: {{ aap_notification_slack_webhook }}
{% endif %}
