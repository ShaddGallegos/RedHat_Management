---
# Execution Environment for GCP-Satellite Integration
# Generated by aap_gcp role

version: 3

images:
  base_image:
    name: {{ aap_ee_base_image }}

dependencies:
  galaxy:
    collections:
{% for collection in aap_required_collections %}
      - name: {{ collection.name }}
        version: "{{ collection.version }}"
{% endfor %}
  
  python:
{% for package in aap_ee_python_packages %}
    - {{ package }}
{% endfor %}

  system:
{% for package in aap_ee_system_packages %}
    - {{ package }}
{% endfor %}

additional_build_steps:
  prepend_galaxy:
    - RUN pip3 install --upgrade pip setuptools
  
  append_final:
    - RUN chmod -R g=u /runner
    - RUN ansible-galaxy collection list

options:
  package_manager_path: /usr/bin/microdnf
  user: 1000
