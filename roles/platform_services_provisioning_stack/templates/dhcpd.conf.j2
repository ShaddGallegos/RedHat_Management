---
# DHCP Configuration Template

# DHCP Server Configuration for 10.168.0.0/16 Network
# Generated by Ansible - DO NOT EDIT MANUALLY

# Options for all subnets
option domain-name "{{ platform_services_provisioning_stack_dhcp_option_domain_name }}";
option domain-name-servers {% for ns in platform_services_provisioning_stack_dhcp_option_domain_name_servers %}{{ ns }}{{ "," if not loop.last else "" }}{% endfor %};

# NTP Servers
option ntp-servers {% for ntp in platform_services_provisioning_stack_dhcp_option_ntp_servers %}{{ ntp }}{{ "," if not loop.last else "" }}{% endfor %};

# NetBIOS Name Servers
option netbios-name-servers {% for nbns in platform_services_provisioning_stack_dhcp_option_netbios_name_servers %}{{ nbns }}{{ "," if not loop.last else "" }}{% endfor %};

# DHCP Server behavior
default-lease-time {{ platform_services_provisioning_stack_dhcp_default_lease_time }};
max-lease-time {{ platform_services_provisioning_stack_dhcp_max_lease_time }};

# Do not update DNS dynamically
ddns-update-style none;

# Log DHCP activities
log-facility local7;

# Main Subnet Configuration: 10.168.0.0/16
subnet {{ platform_services_provisioning_stack_dhcp_subnet }} netmask {{ platform_services_provisioning_stack_dhcp_netmask }} {
  option routers {{ platform_services_provisioning_stack_dhcp_option_routers }};
  option domain-name "{{ platform_services_provisioning_stack_dhcp_option_domain_name }}";
  
  # Main DHCP range
  range {{ platform_services_provisioning_stack_dhcp_range_start }} {{ platform_services_provisioning_stack_dhcp_range_end }};
  
  # PXE Boot Options
  next-server {{ platform_services_provisioning_stack_provisioning_interface_ip }};
  filename "{{ platform_services_provisioning_stack_pxe_bootloader }}";
  
  # Lease timing
  default-lease-time {{ platform_services_provisioning_stack_dhcp_default_lease_time }};
  max-lease-time {{ platform_services_provisioning_stack_dhcp_max_lease_time }};
}

# Host Group: Infrastructure (10.168.0.0/24)
class "platform_infrastructure_core-servers" {
  match if (substring(hardware, 1, 3) = 52:54:00) and
           (binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.0\.");
  option domain-name "prod.spg";
  option domain-name-servers 10.168.0.1, 10.168.1.53, 8.8.8.8;
}

# Static Host: Satellite
host scenario_satellite-prod-spg {
  hardware ethernet 52:54:00:00:00:10;
  fixed-address 10.168.0.10;
  option host-name "scenario_satellite.prod.spg";
  option domain-name-servers 10.168.0.1, 10.168.1.53, 8.8.8.8;
  next-server {{ platform_services_provisioning_stack_provisioning_interface_ip }};
  filename "{{ platform_services_provisioning_stack_pxe_bootloader }}";
}

# Static Host: IDM
host idm-prod-spg {
  hardware ethernet 52:54:00:00:00:20;
  fixed-address 10.168.0.20;
  option host-name "idm.prod.spg";
  option domain-name-servers 10.168.0.1, 10.168.1.53, 8.8.8.8;
  next-server {{ platform_services_provisioning_stack_provisioning_interface_ip }};
  filename "{{ platform_services_provisioning_stack_pxe_bootloader }}";
}

# Static Host: AAP
host aap-prod-spg {
  hardware ethernet 52:54:00:00:00:30;
  fixed-address 10.168.0.30;
  option host-name "aap.prod.spg";
  option domain-name-servers 10.168.0.1, 10.168.1.53, 8.8.8.8;
  next-server {{ platform_services_provisioning_stack_provisioning_interface_ip }};
  filename "{{ platform_services_provisioning_stack_pxe_bootloader }}";
}

# Host Group: Application Servers (10.168.1.0/24)
class "application-servers" {
  match if binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.1\.";
  option domain-name "example.com";
}

# Host Group: Container Hosts (10.168.2.0/24)
class "container-hosts" {
  match if binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.2\.";
  option domain-name "example.com";
}

# Host Group: Database Servers (10.168.3.0/24)
class "database-servers" {
  match if binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.3\.";
  option domain-name "example.com";
}

# Host Group: Development (10.168.100.0/24)
class "development-servers" {
  match if binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.100\.";
  option domain-name "lab.example.com";
}

# Host Group: Reserved Internal (10.168.240.0/21)
class "reserved-internal" {
  match if binary-to-ascii(10, 8, ".", leased-address) ~= "^10\.168\.(24[0-7])\.";
  option domain-name "example.com";
}
