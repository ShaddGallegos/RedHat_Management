# Inventory generated by generate_and_propagate_hosts.yml
# Scenario: {{ scenario }}

{% set types = hosts_entries | map(attribute='type') | list | unique %}
{% for t in types %}
[{{ t }}]
{% for h in hosts_entries if h.type == t %}
{{ h.name }} ansible_host={{ h.ip }} ansible_user={{ inventory_admin_user | default('admin') }} ansible_password={{ inventory_admin_password | default('changeme') }} ansible_become=true
{% endfor %}

{% endfor %}
