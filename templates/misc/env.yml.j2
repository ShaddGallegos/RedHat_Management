# Jinja2 template for environment variables (env.yml.j2)
# Render this with your desired values or use as a reference for required variables

# --- Global Section ---
global:
  project_name: {{ global.project_name | default('test-lab') }}
  domain: {{ global.domain | default(lookup('env', 'ANSIBLE_DOMAIN') or 'example.com') }}
  inventory_plugins: {{ global.inventory_plugins | default('./plugins/inventory') }}
  ansible_cfg: {{ global.ansible_cfg | default('ansible.cfg') }}
  ansible_inventory: {{ global.ansible_inventory | default('./inventory/hosts.generated') }}
  aap_password: {{ global.aap_password | default('') }}
  redhat_cdn_username: {{ global.redhat_cdn_username | default('') }}
  redhat_cdn_password: {{ global.redhat_cdn_password | default('') }}
  console_redhat_token: {{ global.console_redhat_token | default('') }}
  global_admin_password: {{ global.global_admin_password | default('') }}
  installer_user: {{ global.installer_user | default('') }}
  installer_password: {{ global.installer_password | default('') }}
  # RHSM / Subscription Manager
  rhsm_username: {{ global.rhsm_username | default('') }}
  rhsm_password: {{ global.rhsm_password | default('') }}
  rhsm_org: {{ global.rhsm_org | default('') }}
  activation_key: {{ global.activation_key | default('') }}

# --- IDM Section ---
idm:
  idm_domain: {{ idm.idm_domain | default(lookup('env', 'ANSIBLE_DOMAIN') or 'example.com') }}
  idm_hostname: {{ idm.idm_hostname | default('idm.' + (lookup('env', 'ANSIBLE_DOMAIN') or 'example.com')) }}
  idm_primary_interface: {{ idm.idm_primary_interface | default('enp2s0') }}
  idm_ip: {{ idm.idm_ip | default('10.168.0.28') }}
  idm_subnet_mask_bits: {{ idm.idm_subnet_mask_bits | default(16) }}
  idm_gateway: {{ idm.idm_gateway | default('10.168.0.1') }}
  idm_admin_username: {{ idm.idm_admin_username | default('admin') }}
  idm_admin_password: {{ idm.idm_admin_password | default('') }}
  idm_ldap_base_dn: {{ idm.idm_ldap_base_dn | default('dc=' + (lookup('env', 'ANSIBLE_DOMAIN') or 'example.com').replace('.', ',dc=')) }}
  idm_kerberos_realm: {{ idm.idm_kerberos_realm | default((lookup('env', 'ANSIBLE_DOMAIN') or 'example.com').upper()) }}
  idm_directory_manager_password: {{ idm.idm_directory_manager_password | default('') }}
  idm_enable_dns: {{ idm.idm_enable_dns | default(true) }}
  idm_dns_forwarders: {{ idm.idm_dns_forwarders | default('10.168.0.1') }}

