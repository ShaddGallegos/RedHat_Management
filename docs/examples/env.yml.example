---
# Path to the vault password file
vault_password_file: ~/.vault_pass.txt

# Environment variables for Satellite
# Copy this file to your local vaulted config at ~/.ansible/conf/env.yml and fill in your values

# Include standard credentials
# Standard credentials template
# Replace with actual values in ~/.ansible/conf/env.yml

# General credentials
admin_user: "admin"
admin_password: "{{ vault_admin_password }}"

# Red Hat credentials
redhat_username: "{{ vault_redhat_username }}"
redhat_password: "{{ vault_redhat_password }}"
redhat_pool_id: "{{ vault_redhat_pool_id }}"
redhat_token: "{{ vault_redhat_token }}"
rh_credentials_token: "{{ vault_rh_credentials_token }}"

# Satellite configuration (provide answers for ansible_dev_node_prompts)
satellite_admin_user: "admin"                    # Satellite admin username
satellite_admin_password: "{{ vault_satellite_admin_password }}"  # Provide in vault
satellite_server: "scenario_satellite.example.com"        # Satellite FQDN
satellite_domain: "example.com"                  # System domain (e.g., output of `hostname -d`)
satellite_primary_interface: "enp2s0"             # NIC to bind DHCP/DNS/TFTP
satellite_fqdn_ip: ""                            # Optional explicit IP for Satellite FQDN (fallback to detected)
satellite_gateway: ""                            # Gateway for primary interface (leave blank to auto-detect)
satellite_nameserver: ""                          # Nameserver to publish via DHCP (leave blank to auto-detect)
satellite_dhcp_range_start: ""                    # DHCP range start (leave blank to auto-compute)
satellite_dhcp_range_end: ""                      # DHCP range end (leave blank to auto-compute)
satellite_pxeserver: ""                           # PXE/TFTP server IP (leave blank to use primary IP)
satellite_initial_admin_email: ""                 # Optional override; defaults to admin@<system_domain>
satellite_mail_relay: ""                          # SMTP relay host:port
satellite_mail_relay_credentials: "{{ vault_satellite_mail_relay_credentials | default('') }}"  # Provide in vault

# ansible-scenario_ansible_cmdb_core configuration
ansible_cmdb_install: true
ansible_cmdb_hostgroups: []               # If empty, will use first host in each group (or all)
ansible_cmdb_primary_host_override: ""    # Force a specific host to run ansible-scenario_ansible_cmdb_core
ansible_cmdb_inventory_path: "/etc/ansible"
ansible_cmdb_inventory_file: "hosts"
ansible_cmdb_data_dir: "/var/www/html/ansible-scenario_ansible_cmdb_core"
ansible_cmdb_hostfacts: ""
ansible_cmdb_expose_via_nginx: false
ansible_cmdb_nginx_server_name: "_"
ansible_cmdb_cron_user: root
ansible_cmdb_cron_special_time: daily

# Firewall services profiles to enable (see roles/platform_firewall_services)
firewall_services_enabled: true
firewall_services_profiles_enabled:
	- scenario_satellite
	- aap
	- eda
	- idm
	- insights
	- rhc
	- ansible_cmdb
firewall_zone: public

# Ansible credentials
ansible_admin_user: "admin"
ansible_admin_password: "{{ vault_ansible_admin_password }}"
ansible_controller_host: "controller.example.com"
ansible_galaxy_token: "{{ vault_ansible_galaxy_token }}"

# GitHub credentials
github_token: "{{ vault_github_token }}"
github_username: "{{ vault_github_username }}"

# Additional secrets
aws_access_key: "{{ vault_aws_access_key }}"
aws_secret_key: "{{ vault_aws_secret_key }}"
azure_client_id: "{{ vault_azure_client_id }}"
azure_client_secret: "{{ vault_azure_client_secret }}"
azure_tenant_id: "{{ vault_azure_tenant_id }}"
azure_subscription_id: "{{ vault_azure_subscription_id }}"

# Project specific variables
# Add your project-specific variables below
# Example environment file - copy to ~/.ansible/conf/env.yml and update with your values
# For security, actual env.yml should never be committed to Git

# Red Hat Credentials
RH_CREDENTIALS_TOKEN: ""
REDHAT_CDN_USERNAME: ""
REDHAT_CDN_PASSWORD: ""

# API URLs

# Project-specific settings
# EXAMPLE_API_KEY: ""
# EXAMPLE_API_SECRET: ""
