# ~/.ansible/conf/env.yml - TEMPLATE
# 
# DO NOT COMMIT THIS FILE TO GIT
# This is a template showing the structure needed for ~/.ansible/conf/env.yml
# Copy this and fill in your actual values
#
# Create the file:
#   mkdir -p ~/.ansible/conf
#   cp env.yml.example ~/.ansible/conf/env.yml
#   chmod 600 ~/.ansible/conf/env.yml
#   # Edit with your credentials
#
# Then before running playbooks:
#   source ~/.ansible/conf/env.yml
#

# ============================================================================
# Red Hat Credentials (from console.redhat.com)
# ============================================================================

# Offline token for Ansible Automation Platform
# Get from: https://console.redhat.com/settings/personal-access-tokens
OFFLINE_TOKEN="your_offline_token_from_console_here"

# Automation Hub Token (for collection content)
# Get from: https://console.redhat.com/ansible/automation-hub/token
AUTOMATION_HUB_TOKEN="your_automation_hub_token_here"
REDHAT_AUTOMATION_HUB_TOKEN="your_automation_hub_token_here"

# Console/API Token
CONSOLE_REDHAT_TOKEN="your_console_token_here"

# Red Hat Credentials Token (alternative format)
RH_CREDENTIALS_TOKEN="your_rh_token_here"

# ImageBuilder Offline Token
IMAGEBUILDER_OFFLINE_TOKEN="your_imagebuilder_token_here"
OFFLINE_TOKEN_VAULT="your_vault_offline_token_here"

# ============================================================================
# Insights Credentials
# ============================================================================

# Insights account number and credentials
INSIGHTS_ACCOUNT="your_insights_account_number"
INSIGHTS_USERNAME="your_insights_username@redhat.com"
INSIGHTS_PASSWORD="your_insights_password"

# ============================================================================
# AAP (Automation Automation Platform) Credentials
# ============================================================================

# Admin user password for AAP Controller
AAP_ADMIN_PASSWORD="your_aap_admin_password"

# Insights integration
AAP_INSIGHTS_API_TOKEN="your_insights_api_token"
AAP_INSIGHTS_ADMIN_USER="your_insights_admin_user"
AAP_INSIGHTS_ADMIN_PASSWORD="your_insights_admin_password"

# ============================================================================
# IDM (Identity Management) Credentials
# ============================================================================

# IDM Admin password
IDM_ADMIN_PASSWORD="your_idm_admin_password"

# Directory Manager password (for initial IDM setup)
IDM_DIRECTORY_MANAGER_PASSWORD="your_directory_manager_password"

# LDAP Bind credentials (for IDM LDAP integration)
IDM_LDAP_BIND_USER="your_ldap_bind_user"
IDM_LDAP_BIND_PASSWORD="your_ldap_bind_password"

# ============================================================================
# Satellite Credentials
# ============================================================================

# Satellite admin password
SATELLITE_ADMIN_PASSWORD="your_satellite_admin_password"

# Satellite VM root SSH public key (optional, for SSH access)
SATELLITE_VM_ROOT_PUBKEY="ssh-rsa AAAAB3NzaC1yc2E... your_public_key_here"

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. This file should NEVER be committed to Git
#    - It's listed in .gitignore for protection
#    - Keep it locally only
#
# 2. File permissions are critical:
#    chmod 600 ~/.ansible/conf/env.yml
#    # Should show: -rw------- 
#
# 3. All values must be actual credentials from your Red Hat account
#    - Get tokens from: https://console.redhat.com
#    - Use real passwords for admin accounts
#    - Account numbers should be numeric
#
# 4. Credential rotation:
#    - Rotate passwords every 90 days
#    - Rotate API tokens every 60 days
#    - Change account passwords if compromised
#
# 5. After editing this file:
#    source ~/.ansible/conf/env.yml
#    # Verify variables loaded:
#    env | grep AAP_ADMIN_PASSWORD
#
# 6. Loading in playbooks:
#    # At start of bash script:
#    source ~/.ansible/conf/env.yml
#    
#    # Then run:
#    ansible-playbook site.yml
#
# ============================================================================
