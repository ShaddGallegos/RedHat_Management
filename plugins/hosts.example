# Example inventory file for LVM Auto-Extension project
# Copy this file to "hosts" and customize for your environment

# === RHEL 8 Systems ===
[rhel8]
rhel8-server-01.example.com
rhel8-server-02.example.com

# === RHEL 9 Systems ===
[rhel9]
rhel9-server-01.example.com
rhel9-server-02.example.com

# === All Nutanix-hosted Systems ===
[nutanix_hosts:children]
rhel8
rhel9

# === Systems with Non-Standard VG/LV Names ===
[custom_lvm]
custom-lvm-01.example.com vg_name=vg_data lv_name=lv_data mount_point=/data

# === Systems with Special Monitoring Thresholds ===
[high_priority]
critical-server-01.example.com threshold_percent=75
